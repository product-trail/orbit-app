# Supabase project settings — https://app.supabase.com/project/_/settings/api
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to view /admin (the founder-only
# signups/activity dashboard). Never prefix with NEXT_PUBLIC_ — this must
# stay server-side only. Anyone not on this list gets a 404 on /admin,
# signed in or not.
ADMIN_EMAILS=
